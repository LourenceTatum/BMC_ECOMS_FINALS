# ---------------------------------------------------------------------------
# Placeholder-only environment template for BMC Commerce.
# NEVER put real secrets here. This file is committed; local copies are not.
# Copy to a local file (e.g. .env / supabase/functions/.env) and fill values.
# See docs/ENVIRONMENT_SETUP.md and docs/SECURITY.md.
# ---------------------------------------------------------------------------

# --- Supabase project (public client configuration, safe to ship in the app) --
# Get these from Supabase Dashboard > Settings > API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-public-anon-key>

# --- Supabase Edge Function secrets (SERVER-ONLY, never in the Flutter app) --
# Set via: supabase secrets set --env-file ./supabase/functions/.env.prod
# Local: supabase/functions/.env (gitignored)
XENDIT_SECRET_KEY=<xnd_development_... or xnd_production_... placeholder>
XENDIT_WEBHOOK_VERIFICATION_TOKEN=<your-callback-token-placeholder>

# --- Xendit hosted checkout return URLs (registered per environment) --
# Development uses the Supabase Edge Function URL; production must be a
# publicly reachable HTTPS URL. Deep links back into the app are configured in
# the Flutter app (see docs/AUTHENTICATION.md and docs/PAYMENT_ARCHITECTURE.md).
XENDIT_SUCCESS_RETURN_URL=https://<your-domain>/checkout/success
XENDIT_CANCEL_RETURN_URL=https://<your-domain>/checkout/cancel
