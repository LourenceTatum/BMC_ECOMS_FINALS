# Repository-level ignores: secret/local files that must NEVER be committed.
# The Flutter app has its own .gitignore at bmc_final/.gitignore.

# Local environment files (placeholders only are committed via .env.example)
.env
.env.local
*.env
!*.env.example

# Supabase local secrets and autogenerated config
supabase/functions/.env
supabase/.temp/
.supabase/
supabase/config.local.toml

# Provider/secret scratch files
*.pem
*.key
*.jwk
secrets/
